      "category": "private_person",
      "subtype": "cn_name",
      "priority": 40,
      "default_enabled": true
    },
    "cn_landline": {
      "label": "座机号",
      "category": "private_phone",
      "subtype": "cn_landline",
      "priority": 70,
      "default_enabled": false
    },
    "cn_date": {
      "label": "中文日期",
      "category": "private_date",
